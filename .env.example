# ─────────────────────────────────────────────────────────────
# Horaneo : exemple de configuration
# Copier ce fichier en ".env" et remplir les valeurs.
# Ne JAMAIS enregistrer le fichier .env dans Git.
# ─────────────────────────────────────────────────────────────

# Identité du produit
PRODUCT_NAME=Horaneo
MAIN_DOMAIN=horaneo.com
# Domaines redirigés vers une langue du site commercial (domaine=langue, séparés par des virgules)
LOCALE_REDIRECT_DOMAINS=horaneo.fr=fr

# Langues activées, séparées par des virgules (fr, en, es, ru).
# Chaque langue doit avoir son fichier messages/<langue>.json.
ENABLED_LOCALES=fr

# Base de données PostgreSQL
# Propriétaire de la base : utilisé UNIQUEMENT pour les migrations et les scripts.
DATABASE_URL=postgres://horaneo:horaneo@localhost:5432/horaneo
# Rôle restreint utilisé par l'application, soumis aux règles d'accès par ligne.
# Créé ou mis à jour par `pnpm db:roles` à partir du nom et du mot de passe ci-dessous.
# En production : choisir un long mot de passe aléatoire.
APP_DATABASE_URL=postgres://app_runtime:change-me-locally@localhost:5432/horaneo

# Bases utilisées par les tests automatiques (la base de test est vidée à chaque lancement)
TEST_DATABASE_URL=postgres://horaneo:horaneo@localhost:5432/horaneo_test
TEST_APP_DATABASE_URL=postgres://app_runtime:change-me-locally@localhost:5432/horaneo_test

# Adresse publique du site commercial (par défaut : https://MAIN_DOMAIN en production,
# http://localhost:3000 en développement)
# PUBLIC_APP_URL=

# ── Connexion ────────────────────────────────────────────────
# Clé secrète des sessions : 32 caractères minimum, OBLIGATOIRE en production.
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google (console.cloud.google.com) : laisser vide pour masquer le bouton
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple : laisser vide tant que le compte développeur Apple n'existe pas
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# En-tête donnant l'adresse IP réelle des visiteurs (limitation des tentatives).
# Derrière Cloudflare : cf-connecting-ip
CLIENT_IP_HEADERS=x-forwarded-for

# ── Assistance (espace gérante) ───────────────────────────────
# Par défaut : support@MAIN_DOMAIN
SUPPORT_EMAIL=
# WhatsApp de l'assistance prioritaire (pack Sérénité), chiffres seulement : 33612345678
SUPPORT_WHATSAPP=

# ── E-mails et SMS (Brevo) ───────────────────────────────────
# Une seule clé pour les e-mails et les SMS (Brevo → SMTP & API → Clés API).
# Sans clé : en développement, e-mails et SMS s'affichent dans le terminal.
# Pour les SMS : acheter des crédits SMS dans Brevo. L'adresse d'expédition doit être un domaine vérifié dans Brevo.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@horaneo.com

# ── Avis Google (Google Places API) ──────────────────────────
# Une seule clé pour tous les sites (Google Cloud → API « Places API (New) » → Identifiants).
# Restreindre la clé à cette API. Sans clé : le site affiche seulement un lien vers les avis.
GOOGLE_PLACES_API_KEY=

# ── Stockage des fichiers (Cloudflare R2) ────────────────────
# Sans ces variables, en développement : dossier local "storage/" servi par /media.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Domaine public du bucket (ex. https://media.horaneo.com)
R2_PUBLIC_URL=
# auto (R2 si configuré) | local (dossier du serveur, choix explicite) | r2
STORAGE_DRIVER=auto

# ── Sauvegarde des fichiers (pnpm files:backup, chaque nuit) ─
# Compartiment R2 de sauvegarde, distinct des photos en ligne. Clé R2 limitée à ce compartiment.
# Endpoint : https://<id-du-compte>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Les variables des étapes suivantes (Stripe, Cloudflare, Anthropic)
# seront ajoutées ici au fur et à mesure.

# ─── Paiements des acomptes : Stripe Connect (comptes Standard, paiements directs) ───
# Clés du compte Stripe de la plateforme (Tableau de bord Stripe → Développeurs → Clés API).
# En local, utiliser les clés de test (sk_test_…, pk_test_…). Sans ces trois clés, le paiement en ligne est désactivé.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Point de réception à créer dans Stripe (Développeurs → Webhooks → « Événements des comptes connectés »)
# vers https://<domaine principal>/api/stripe/connect, avec les événements :
# account.updated, account.application.deauthorized, payment_intent.succeeded,
# payment_intent.payment_failed, payment_intent.canceled, refund.created, refund.updated, refund.failed
# En local : stripe listen --forward-connect-to localhost:3000/api/stripe/connect
STRIPE_CONNECT_WEBHOOK_SECRET=
# Abonnements des professionnels (Stripe Billing) : second point de réception, « Événements de votre compte »,
# vers https://<domaine principal>/api/stripe/billing, avec les événements :
# checkout.session.completed, customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_failed
# Dans Stripe → Facturation → Abonnements : « après l'échec de toutes les tentatives : annuler l'abonnement »
# (le site repasse alors au pack gratuit), et activer le portail client (carte et factures).
# En local : stripe listen --forward-to localhost:3000/api/stripe/billing
STRIPE_BILLING_WEBHOOK_SECRET=

# ─── Tâche planifiée (rappels, résumés, envoi des messages, nettoyage) ───
# Secret partagé avec la tâche Coolify qui appelle /api/cron/tick toutes les 5 minutes.
# Générer avec : openssl rand -base64 32
CRON_SECRET=
