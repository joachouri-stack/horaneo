# ─────────────────────────────────────────────────────────────
# Horaneo : exemple de configuration
# Copier ce fichier en ".env" et remplir les valeurs.
# Ne JAMAIS enregistrer le fichier .env dans Git.
# ─────────────────────────────────────────────────────────────

# Identité du produit
PRODUCT_NAME=Horaneo
MAIN_DOMAIN=horaneo.com
# Domaines redirigés vers une langue du site commercial (domaine=langue, séparés par des virgules)
LOCALE_REDIRECT_DOMAINS=horaneo.fr=fr

# Langues activées, séparées par des virgules (fr, en, es, ru).
# Chaque langue doit avoir son fichier messages/<langue>.json.
ENABLED_LOCALES=fr

# Base de données PostgreSQL
# Propriétaire de la base : utilisé UNIQUEMENT pour les migrations et les scripts.
DATABASE_URL=postgres://horaneo:horaneo@localhost:5432/horaneo
# Rôle restreint utilisé par l'application, soumis aux règles d'accès par ligne.
# Créé ou mis à jour par `pnpm db:roles` à partir du nom et du mot de passe ci-dessous.
# En production : choisir un long mot de passe aléatoire.
APP_DATABASE_URL=postgres://app_runtime:change-me-locally@localhost:5432/horaneo

# Bases utilisées par les tests automatiques (la base de test est vidée à chaque lancement)
TEST_DATABASE_URL=postgres://horaneo:horaneo@localhost:5432/horaneo_test
TEST_APP_DATABASE_URL=postgres://app_runtime:change-me-locally@localhost:5432/horaneo_test

# Adresse publique du site commercial (par défaut : https://MAIN_DOMAIN en production,
# http://localhost:3000 en développement)
# PUBLIC_APP_URL=

# ── Connexion ────────────────────────────────────────────────
# Clé secrète des sessions : 32 caractères minimum, OBLIGATOIRE en production.
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google (console.cloud.google.com) : laisser vide pour masquer le bouton
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple : laisser vide tant que le compte développeur Apple n'existe pas
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# En-tête donnant l'adresse IP réelle des visiteurs (limitation des tentatives).
# Derrière Cloudflare : cf-connecting-ip
CLIENT_IP_HEADERS=x-forwarded-for

# ── Assistance (espace gérante) ───────────────────────────────
# Par défaut : support@MAIN_DOMAIN
SUPPORT_EMAIL=
# WhatsApp de l'assistance prioritaire (pack Sérénité), chiffres seulement : 33612345678
SUPPORT_WHATSAPP=

# ── E-mails (Brevo) ──────────────────────────────────────────
# Sans clé : en développement, les e-mails (liens de connexion) s'affichent dans le terminal.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@horaneo.com

# ── Stockage des fichiers (Cloudflare R2) ────────────────────
# Sans ces variables, en développement : dossier local "storage/" servi par /media.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Domaine public du bucket (ex. https://media.horaneo.com)
R2_PUBLIC_URL=
# auto (R2 si configuré) | local (dossier du serveur, choix explicite) | r2
STORAGE_DRIVER=auto

# Les variables des étapes suivantes (Stripe, Cloudflare, Anthropic)
# seront ajoutées ici au fur et à mesure.
